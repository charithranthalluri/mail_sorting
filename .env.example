# =============================================================================
# Gmail OAuth2 Configuration
# =============================================================================
# Path to the OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path where the OAuth2 token will be stored after first authentication
GMAIL_TOKEN_FILE=token.json

# =============================================================================
# LLM Configuration
# =============================================================================
# LLM provider:
#   - "offline": 100% offline rule-based semantic classifier (zero API keys, zero cloud, instant)
#   - "ollama": Local Ollama LLM (e.g., llama3.2) running on your PC (zero cloud)
#   - "google": Google Gemini API (free tier)
LLM_PROVIDER=offline

# Model name (used if LLM_PROVIDER is "ollama" or "google")
LLM_MODEL=llama3.2

# Ollama local URL (used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# API key for the LLM provider (only needed if LLM_PROVIDER=google)
LLM_API_KEY=

# Maximum retries for LLM calls
MAX_LLM_RETRIES=3

# Timeout in seconds for LLM calls
LLM_TIMEOUT_SECONDS=60

# Maximum characters of email body to send to LLM
LLM_MAX_BODY_CHARS=8000

# Temperature for LLM generation (lower = more deterministic)
LLM_TEMPERATURE=0.1

# =============================================================================
# Application Configuration
# =============================================================================
# Polling interval in seconds (default: 5 minutes)
POLL_INTERVAL_SECONDS=300

# How many hours back to look for emails on first run (0 = only new emails)
INITIAL_LOOKBACK_HOURS=0

# Dry-run mode: classify emails but don't modify Gmail (default: true for safety)
DRY_RUN=true

# Maximum emails to process per polling cycle
MAX_EMAILS_PER_CYCLE=25

# =============================================================================
# Database Configuration
# =============================================================================
# Path to the SQLite database file
DATABASE_PATH=data/mail_sorter.db

# =============================================================================
# Label Configuration
# =============================================================================
# Prefix for all AI-managed Gmail labels
LABEL_PREFIX=AI

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty for console-only logging)
LOG_FILE=data/mail_sorter.log
